# 若直接在服务器 IP 上访问，请将 localhost 改为服务器公网 IP。
APP_ORIGIN=http://localhost:8080
STORAGE_ORIGIN=http://localhost:9000
WEB_PORT=8080
STORAGE_PORT=9000
MINIO_CONSOLE_PORT=9001
COOKIE_SECURE=false

# 打包脚本会在成品 .env 中自动生成下列三个密钥。
POSTGRES_PASSWORD=replace-with-random-database-password
MINIO_ROOT_USER=paperlingo
MINIO_ROOT_PASSWORD=replace-with-random-object-storage-password
JWT_SECRET=replace-with-at-least-32-random-characters
